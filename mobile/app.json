{
  "expo": {
    "name": "Pinball Practice",
    "slug": "pinball-practice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1426",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#f4f3f0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f0f0e"
          }
        }
      ],
      "expo-image",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "scheme": "pinballpractice",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "auth": {
        "region": "us-west-2",
        "domain": "https://us-west-2pasrrojo7.auth.us-west-2.amazoncognito.com",
        "userPoolId": "us-west-2_pASrrOjo7",
        "clientId": "2mjk3k94a95bctt2mi7ddjaiq"
      }
    }
  }
}
